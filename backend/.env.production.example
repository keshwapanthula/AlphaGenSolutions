# Production server settings
PORT=5000
NODE_ENV=production

# Comma-separated frontend domains that are allowed by CORS
# Example includes Vercel preview + a custom domain.
FRONTEND_URLS=https://alphagensolutions.vercel.app,https://alphagensolutions.com

# MongoDB Atlas free-tier URI
# Replace username, password, cluster host, and database name.
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<cluster-host>/alphagen?retryWrites=true&w=majority

# Email delivery (Gmail app password recommended)
EMAIL_SERVICE=gmail
EMAIL_USER=info@alphagensolutions.com
EMAIL_PASS=replace-with-app-password
EMAIL_FROM=noreply@alphagensolutions.com
EMAIL_TO=info@alphagensolutions.com

# Contact endpoint protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
